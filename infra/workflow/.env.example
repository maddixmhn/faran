# Copy to .env locally; never commit the resulting file.
# Generate each secret independently and keep it unchanged across restarts.
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_ALLOWED_HOSTNAMES=
BETTER_AUTH_SECRET=replace-with-random-64-hex-characters
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=replace-with-a-different-random-64-hex-characters

# No model key is needed for Paperclip/n8n service startup. Add one only after
# selecting a provider, monthly spend cap, and the agent permissions it needs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

N8N_DB_PASSWORD=replace-with-a-private-random-password
N8N_ENCRYPTION_KEY=replace-with-a-random-64-hex-character-key
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_PROXY_HOPS=0
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Tehran

# Set only for the Cloudflare overlay. Create hostname routes and Access
# policies in Cloudflare before starting the tunnel container.
CF_TUNNEL_TOKEN=
